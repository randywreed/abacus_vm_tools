[Unit]
Description=Hermes Classroom secure connector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/hermes-classroom-connector/connector.env
ExecStart=/opt/abacus-python/bin/python /opt/hermes-classroom-connector/hermes_classroom_connector.py
Restart=on-failure
RestartSec=5
TimeoutStartSec=20
TimeoutStopSec=15
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/hermes-classroom-connector /var/lib/hermes-classroom-connector/attachments
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
MemoryMax=512M
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
